#!/usr/bin/env bash
# Run the same documentation lint used by CI when a commit contains staged
# Markdown or GitHub workflow/template changes. The hook is opt-in; install it
# with tools/install-hooks.sh or tools/install-hooks.ps1.

set -euo pipefail

if git diff --cached --quiet -- '*.md' '*.yml' '*.yaml'; then
    exit 0
fi

python_bin="${PYTHON:-python}"
if ! command -v "$python_bin" >/dev/null 2>&1; then
    if command -v python3 >/dev/null 2>&1; then
        python_bin=python3
    else
        echo "ERROR: documentation changes are staged but Python 3 was not found." >&2
        echo "Install Python 3 or set PYTHON to its executable, then retry the commit." >&2
        exit 1
    fi
fi

exec "$python_bin" tools/docs_lint.py
